<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 设计系统 · 尺寸规范
  更大的圆角、更宽松的间距
-->
<resources>
    <!-- 页面边距 -->
    <dimen name="page_margin">20dp</dimen>
    <dimen name="page_margin_large">24dp</dimen>

    <!-- 模块间距 -->
    <dimen name="module_gap_large">24dp</dimen>
    <dimen name="module_gap">16dp</dimen>
    <dimen name="group_gap">12dp</dimen>
    <dimen name="group_gap_small">8dp</dimen>

    <!-- Material 3 圆角（更大、更柔和） -->
    <dimen name="card_radius">20dp</dimen>
    <dimen name="card_radius_large">24dp</dimen>
    <dimen name="card_radius_small">16dp</dimen>
    <dimen name="chip_radius">12dp</dimen>
    <dimen name="button_radius">16dp</dimen>
    <dimen name="dialog_radius">28dp</dimen>

    <!-- 分隔线（Material 3 风格：更少使用分隔线，使用空间分隔） -->
    <dimen name="divider_height">0dp</dimen>

    <!-- 导航栏 -->
    <dimen name="nav_height">80dp</dimen>
    <dimen name="nav_indicator_width">64dp</dimen>
    <dimen name="nav_indicator_height">32dp</dimen>
    <dimen name="nav_indicator_radius">16dp</dimen>

