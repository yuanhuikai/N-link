<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 主框架：内容区 + Material 3 底部导航栏
  使用 Material 3 NavigationBar 风格：胶囊指示器、标签常显
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- 状态栏占位 -->
    <View
        android:id="@+id/statusGlass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorSurface" />

    <!-- 内容区 -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 分隔线（Material 3 风格：移除或弱化） -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <!-- Material 3 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:background="@color/nav_background"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <!-- 设备 Tab -->
        <LinearLayout
            android:id="@+id/tabDashboard"
            style="@style/NlNavItem">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <View
                    android:id="@+id/indicatorDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_selected"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/iconDashboard"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="设备"
                    android:src="@drawable/ic_nav_home" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelDashboard"
                style="@style/NlNavItem.Label"
                android:text="设备"
                android:textColor="@color/nav_active_icon" />
        </LinearLayout>

        <!-- 相册 Tab -->
        <LinearLayout
            android:id="@+id/tabTransfer"
            style="@style/NlNavItem">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <View
                    android:id="@+id/indicatorTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_selected"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/iconTransfer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="相机照片"
                    android:src="@drawable/ic_nav_album" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelTransfer"
                style="@style/NlNavItem.Label"
                android:text="相册"
                android:textColor="@color/nav_inactive_icon" />
        </LinearLayout>

        <!-- 拍摄 Tab -->
        <LinearLayout
            android:id="@+id/tabRemote"
            style="@style/NlNavItem">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <View
                    android:id="@+id/indicatorRemote"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_selected"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/iconRemote"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="拍摄"
                    android:src="@drawable/ic_nav_camera" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelRemote"
                style="@style/NlNavItem.Label"
                android:text="拍摄"
                android:textColor="@color/nav_inactive_icon" />
        </LinearLayout>

        <!-- 设置 Tab -->
        <LinearLayout
            android:id="@+id/tabSettings"
            style="@style/NlNavItem">

            <FrameLayout
                android:layout_width="@dimen/nav_indicator_width"
                android:layout_height="@dimen/nav_indicator_height">

                <View
                    android:id="@+id/indicatorSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_selected"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="设置"
                    android:src="@drawable/ic_nav_settings" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelSettings"
                style="@style/NlNavItem.Label"
                android:text="设置"
                android:textColor="@color/nav_inactive_icon" />
        </LinearLayout>
    </LinearLayout>

    <!-- 兼容旧代码的 contentColumn 引用 -->
    <FrameLayout
        android:id="@+id/contentColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
