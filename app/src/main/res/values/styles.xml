<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 设计系统 · 组件样式
  大圆角、更宽松的间距、清晰的层级
-->
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════════
         排版层级
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="NlText" parent="TextAppearance.Material3.BodyMedium" />

    <style name="NlText.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="NlText.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NlText.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NlText.GroupTitle" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="NlText.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="NlText.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="NlText.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         按钮样式
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 主要按钮：填充样式 -->
    <style name="NlButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tonal 按钮：次要强调 -->
    <style name="NlButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 描边按钮：次要操作 -->
    <style name="NlButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 文字按钮 -->
    <style name="NlButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 对比按钮（用于深色卡片内） -->
    <style name="NlButton.Contrast" parent="NlButton.Primary">
        <item name="backgroundTint">@color/dark_card_inner</item>
        <item name="android:textColor">@color/on_dark_card</item>
    </style>

    <style name="NlButton.ContrastOutline" parent="NlButton.Outline">
        <item name="android:textColor">@color/on_dark_card</item>
        <item name="strokeColor">@color/on_dark_card_variant</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         顶栏样式
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="NlTopChrome">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="NlTopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/page_margin</item>
    </style>

    <style name="NlTopDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         卡片样式
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 内容卡片：填充式，无边框 -->
    <style name="NlCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 描边卡片 -->
    <style name="NlCard.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 滚轮选择器 -->
    <style name="NlPicker">
        <item name="colorControlNormal">?attr/colorOutline</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         设置项样式
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="NlSettingsItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         导航栏样式（Material 3 NavigationBar 风格）
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="NlNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="NlNavItem.Icon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="NlNavItem.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
