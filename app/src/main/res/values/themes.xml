<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 / Material You 设计系统
  支持 DynamicColors（Android 12+）跟随系统壁纸主题色
  低版本设备使用 colors.xml 中定义的静态 fallback 配色
-->
<resources>
    <!-- 主题基础 -->
    <style name="Theme.NLink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary 色系 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary 色系 -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary 色系 -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- 背景与表面 -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- 错误色 -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- 边框 -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- 系统栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- 字体 -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- 形状系统 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.NLink.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NLink.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.NLink.LargeComponent</item>

        <!-- 组件样式覆盖 -->
        <item name="materialAlertDialogTheme">@style/NlDialog</item>
        <item name="switchStyle">@style/Widget.NlSwitch</item>
        <item name="materialCardViewStyle">@style/Widget.NLink.CardView</item>
        <item name="chipStyle">@style/Widget.NLink.Chip</item>

        <!-- 页面转场动画 -->
        <item name="android:windowAnimationStyle">@style/NlWindowAnim</item>
    </style>

    <!-- 全屏预览页主题（纯黑沉浸） -->
    <style name="Theme.NLink.Preview" parent="Theme.NLink">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         形状系统（Material 3 大圆角风格）
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="ShapeAppearance.NLink.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.NLink.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.NLink.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.NLink.ExtraLargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         动画
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="NlWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         组件样式
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Material 3 弹窗 -->
    <style name="NlDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NLink.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NLink.Button.Dialog.Text</item>
    </style>

    <style name="NlDialog.Glass" parent="NlDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Material 3 Switch -->
    <style name="Widget.NlSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <!-- Material 3 CardView -->
    <style name="Widget.NLink.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.NLink.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.NLink.CardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Material 3 Chip -->
    <style name="Widget.NLink.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipBackgroundColor">@color/chip_unselected</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.NLink.Chip.Selected" parent="Widget.NLink.Chip">
        <item name="chipBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <!-- 弹窗按钮 -->
    <style name="Widget.NLink.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.NLink.Button.Dialog.Text" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
