<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 遥控拍摄：实时监看(2/3) + 参数控制区(1/3)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- 顶部：照片/视频模式切换 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_margin">

        <!-- 照片/视频切换 -->
        <FrameLayout
            android:id="@+id/modeToggleSlot"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:padding="4dp">

            <View
                android:id="@+id/modeIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_selected" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="照片"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnModeVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="视频"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 画面模式下拉 -->
        <TextView
            android:id="@+id/chipDisplayMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="联动画面 ▾"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRemoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="未连接"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 实时取景区域 -->
    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/page_margin"
        android:layout_weight="2"
        android:background="@drawable/bg_liveview">

        <ImageView
            android:id="@+id/ivLiveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="实时取景画面"
            android:scaleType="fitCenter" />

        <!-- 三分构图网格线 -->
        <ImageView
            android:id="@+id/viewGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="网格线"
            android:scaleType="fitXY"
            android:src="@drawable/bg_grid_thirds"
            android:visibility="gone" />

        <!-- 顶部悬浮信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivLvBattery"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="电量"
                android:src="@drawable/ic_battery"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivLvShots"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:contentDescription="剩余"
                android:src="@drawable/ic_sd_card"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvShots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLvConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textColor="@color/liveview_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 录制状态 -->
        <LinearLayout
            android:id="@+id/layoutRecordBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="录制中"
                android:src="@drawable/ic_record_dot"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvRecordTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 触摸对焦点 -->
        <ImageView
            android:id="@+id/viewFocusIndicator"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="对焦点"
            android:src="@drawable/ic_focus"
            android:visibility="gone"
            app:tint="@color/white" />

        <!-- 开始监看按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartLv"
            style="@style/NlButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:paddingHorizontal="32dp"
            android:text="开始监看" />

        <!-- 全屏入口 -->
        <ImageView
            android:id="@+id/btnFullscreenLv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_fullscreen_button"
            android:contentDescription="全屏监看"
            android:padding="10dp"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/white" />

        <!-- 直方图开关 -->
        <ImageView
            android:id="@+id/btnHistogram"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="58dp"
            android:background="@drawable/bg_fullscreen_button"
            android:contentDescription="@string/histogram_toggle"
            android:padding="10dp"
            android:src="@drawable/ic_histogram"
            app:tint="@color/white" />

        <!-- 实时直方图 -->
        <com.nikonlink.app.camera.liveview.HistogramView
            android:id="@+id/viewHistogram"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- 快门闪白 -->
        <View
            android:id="@+id/viewFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 参数控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- 基础参数行 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/page_margin"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/paramRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 快门区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_margin">

            <FrameLayout
                android:id="@+id/btnTimer"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="定时拍摄"
                    android:src="@drawable/ic_timer"
                    app:tint="?attr/colorOnSurface" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="40dp"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="拍照">

                <ImageView
                    android:id="@+id/ivShutterIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="快门"
                    android:src="@drawable/ic_shutter_white" />
            </FrameLayout>

            <!-- 拍摄模式按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModeAction"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="10dp"
                    android:text="间隔拍摄"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnModeActionArrow"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="切换拍摄模式"
                    android:padding="7dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvShotCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已拍 0 张"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
