<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 动态颜色设计系统
  支持 Android 12+ 壁纸主题色提取；低版本设备使用下方静态 fallback 配色（青色系）
-->
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════════
         Material 3 Fallback 色板（Teal/Cyan 青色系 - 专业相机工具调性）
         DynamicColors 在 Android 12+ 生效时会自动覆盖这些值
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Primary 色系 -->
    <color name="md_theme_light_primary">#006A6A</color>
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_primaryContainer">#9CF1F0</color>
    <color name="md_theme_light_onPrimaryContainer">#002020</color>

    <!-- Secondary 色系 -->
    <color name="md_theme_light_secondary">#4A6363</color>
    <color name="md_theme_light_onSecondary">#FFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#CCE8E7</color>
    <color name="md_theme_light_onSecondaryContainer">#051F1F</color>

    <!-- Tertiary 色系 -->
    <color name="md_theme_light_tertiary">#4B607C</color>
    <color name="md_theme_light_onTertiary">#FFFFFF</color>
    <color name="md_theme_light_tertiaryContainer">#D3E4FF</color>
    <color name="md_theme_light_onTertiaryContainer">#041C35</color>

    <!-- Error 色系 -->
    <color name="md_theme_light_error">#BA1A1A</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_errorContainer">#FFDAD6</color>
    <color name="md_theme_light_onErrorContainer">#410002</color>

    <!-- 背景与表面 -->
    <color name="md_theme_light_background">#FAFDFC</color>
    <color name="md_theme_light_onBackground">#191C1C</color>
    <color name="md_theme_light_surface">#FAFDFC</color>
    <color name="md_theme_light_onSurface">#191C1C</color>
    <color name="md_theme_light_surfaceVariant">#DAE5E4</color>
    <color name="md_theme_light_onSurfaceVariant">#3F4948</color>

    <!-- Surface Container 层级（Material 3 elevation tones） -->
    <color name="md_theme_light_surfaceContainerLowest">#FFFFFF</color>
    <color name="md_theme_light_surfaceContainerLow">#F4F7F6</color>
    <color name="md_theme_light_surfaceContainer">#EEF1F0</color>
    <color name="md_theme_light_surfaceContainerHigh">#E8EBEA</color>
    <color name="md_theme_light_surfaceContainerHighest">#E2E5E4</color>

    <!-- 边框与分隔 -->
    <color name="md_theme_light_outline">#6F7978</color>
    <color name="md_theme_light_outlineVariant">#BEC9C8</color>

    <!-- 其他 -->
    <color name="md_theme_light_inverseSurface">#2D3131</color>
    <color name="md_theme_light_inverseOnSurface">#EFF1F0</color>
    <color name="md_theme_light_inversePrimary">#80D5D4</color>
    <color name="md_theme_light_scrim">#000000</color>

    <!-- ═══════════════════════════════════════════════════════════════════════
         语义色 token（用于代码/布局引用，DynamicColors 会自动映射）
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 背景层 -->
    <color name="background">@color/md_theme_light_background</color>
    <color name="surface">@color/md_theme_light_surface</color>
    <color name="surface_variant">@color/md_theme_light_surfaceVariant</color>
    <color name="surface_container">@color/md_theme_light_surfaceContainer</color>
    <color name="surface_container_high">@color/md_theme_light_surfaceContainerHigh</color>
    <color name="surface_container_low">@color/md_theme_light_surfaceContainerLow</color>

    <!-- 主色 -->
    <color name="primary">@color/md_theme_light_primary</color>
    <color name="primary_variant">@color/md_theme_light_primaryContainer</color>
    <color name="on_primary">@color/md_theme_light_onPrimary</color>
    <color name="primary_container">@color/md_theme_light_primaryContainer</color>
    <color name="on_primary_container">@color/md_theme_light_onPrimaryContainer</color>

    <!-- 次要色 -->
    <color name="secondary">@color/md_theme_light_secondary</color>
    <color name="secondary_variant">@color/md_theme_light_secondaryContainer</color>
    <color name="on_secondary">@color/md_theme_light_onSecondary</color>
    <color name="secondary_container">@color/md_theme_light_secondaryContainer</color>
    <color name="on_secondary_container">@color/md_theme_light_onSecondaryContainer</color>

    <!-- 第三色 -->
    <color name="tertiary">@color/md_theme_light_tertiary</color>
    <color name="tertiary_container">@color/md_theme_light_tertiaryContainer</color>
    <color name="on_tertiary">@color/md_theme_light_onTertiary</color>
    <color name="on_tertiary_container">@color/md_theme_light_onTertiaryContainer</color>

    <!-- 文字层 -->
    <color name="text_primary">@color/md_theme_light_onSurface</color>
    <color name="text_secondary">@color/md_theme_light_onSurfaceVariant</color>
    <color name="text_tertiary">#6F7978</color>
    <color name="on_background">@color/md_theme_light_onBackground</color>
    <color name="on_surface">@color/md_theme_light_onSurface</color>
    <color name="on_surface_variant">@color/md_theme_light_onSurfaceVariant</color>

    <!-- 边框 -->
    <color name="outline">@color/md_theme_light_outline</color>
    <color name="outline_variant">@color/md_theme_light_outlineVariant</color>
    <color name="divider">@color/md_theme_light_outlineVariant</color>

    <!-- 错误状态 -->
    <color name="error">@color/md_theme_light_error</color>
    <color name="on_error">@color/md_theme_light_onError</color>
    <color name="error_container">@color/md_theme_light_errorContainer</color>

    <!-- 状态色 -->
    <color name="status_connected">@color/md_theme_light_primary</color>
    <color name="status_disconnected">#9CA3AF</color>

    <!-- 诊断状态色（用于诊断事件时间线） -->
    <color name="success">#2E7D32</color>
    <color name="warning">#F9A825</color>

    <!-- 强调色（兼容旧代码） -->
    <color name="accent">@color/md_theme_light_primary</color>
    <color name="accent_soft">@color/md_theme_light_primaryContainer</color>
    <color name="panel_2">@color/md_theme_light_surfaceContainerLow</color>

    <!-- Chip 组件 -->
    <color name="chip_unselected">@color/md_theme_light_surfaceContainerHigh</color>
    <color name="chip_selected">@color/md_theme_light_secondaryContainer</color>

    <!-- Switch 开关 -->
    <color name="switch_track_off">#79747E</color>
    <color name="switch_thumb_off">#FFFFFF</color>

    <!-- 对比卡片（设备信息卡：深色背景以突出） -->
    <color name="dark_card">@color/md_theme_light_inverseSurface</color>
    <color name="dark_card_inner">#3D4545</color>
    <color name="dark_card_surface">#4A5151</color>
    <color name="on_dark_card">@color/md_theme_light_inverseOnSurface</color>
    <color name="on_dark_card_variant">#A8AFAF</color>

    <!-- 导航栏 -->
    <color name="nav_background">@color/md_theme_light_surfaceContainer</color>
    <color name="nav_selected_bg">@color/md_theme_light_secondaryContainer</color>
    <color name="nav_active_icon">@color/md_theme_light_onSecondaryContainer</color>
    <color name="nav_inactive_icon">@color/md_theme_light_onSurfaceVariant</color>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Live View 专用色（保持深色高对比度，不受动态颜色影响）
         ═══════════════════════════════════════════════════════════════════════ -->
    <color name="liveview_scrim">#99000000</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="liveview_text">#E6FFFFFF</color>

    <!-- 全屏监看：深色专业工具调性 -->
    <color name="lv_accent">#80D5D4</color>
    <color name="lv_accent_soft">#2680D5D4</color>
    <color name="lv_panel">#F5141416</color>
    <color name="lv_card">#F21B1B1D</color>
    <color name="lv_card_solid">#F21B1B1D</color>
    <color name="lv_chip">#F2252527</color>
    <color name="lv_chip_active">#33FFFFFF</color>
    <color name="lv_text">#FFFFFFFF</color>
    <color name="lv_text_dim">#8CFFFFFF</color>
    <color name="lv_outline">#26FFFFFF</color>
    <color name="lv_badge_red">#8A2B26</color>
    <color name="lv_seg_track">#1FFFFFFF</color>
    <color name="lv_seg_sel">#33FFFFFF</color>

    <!-- ═══════════════════════════════════════════════════════════════════════
         兼容旧代码的 token（逐步废弃）
         ═══════════════════════════════════════════════════════════════════════ -->
    <color name="page">@color/background</color>
    <color name="nikon_yellow">@color/md_theme_light_primary</color>
    <color name="on_nikon_yellow">@color/md_theme_light_onPrimary</color>
    <color name="ble_indicator">@color/text_secondary</color>
    <color name="wifi_indicator">@color/text_primary</color>
</resources>
